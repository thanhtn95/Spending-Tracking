# Neon PostgreSQL connection string (keep sslmode=require for Neon)
DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require

# Gemini API key (Google AI Studio free tier)
GEMINI_API_KEY=your_gemini_api_key_here

# Authentication (JWT signing secret, minimum 32 chars — store in Secret Manager in prod)
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRATION_HOURS=168
# Set to false after creating your personal account to block new signups
ALLOW_REGISTRATION=true

# Optional Gemini model overrides (defaults match spec)
GEMINI_MODEL_IMAGE=gemini-3.5-flash-lite
GEMINI_MODEL_PDF=gemini-3.8-flash

# Optional defaults
DEFAULT_CURRENCY=VND
RUN_MIGRATIONS=true
PORT=8080
RUST_LOG=spending_tracker_api=info,tower_http=info
